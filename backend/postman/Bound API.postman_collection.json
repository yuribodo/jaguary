            },
            "description": "Returns the pinned normalized VuelaYa profile. Local endpoint relations are advertised in Link."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile publishes Checkout + AP2\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.merchant_id).to.equal(\"merchant_vuelaya\");",
                  "  pm.expect(body.protocol).to.deep.equal({ name: \"UCP\", version: \"2026-08-25\" });",
                  "  pm.expect(body.capabilities.map((capability) => capability.name)).to.deep.equal([\"dev.ucp.shopping.checkout\", \"dev.ucp.common.payment.ap2_mandate\"]);",
                  "  pm.expect(body.capabilities[1].extends).to.deep.equal([\"dev.ucp.shopping.checkout\"]);",
                  "  pm.expect(pm.response.headers.get(\"Link\")).to.include(\"/ucp/v1/checkout\");",
                  "});"
