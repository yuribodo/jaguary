    {
      "name": "HTTP conventions",
      "item": [
        {
          "name": "Unknown route returns error envelope",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/__postman/not-found",
              "host": ["{{baseUrl}}"],
              "path": ["__postman", "not-found"]
            },
            "description": "Exercises the stable 404 error envelope."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unknown route uses the public error envelope\", function () {",
                  "  pm.response.to.have.status(404);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.equal(\"not_found\");",
                  "  pm.expect(body.error.message).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.error.details).to.deep.equal({});",
                  "  pm.expect(body.correlation_id).to.equal(pm.variables.get(\"correlationId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mutable request rejects missing Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
