  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Response includes X-Correlation-Id\", function () {",
          "  pm.expect(pm.response.headers.get(\"X-Correlation-Id\")).to.match(/^[A-Za-z0-9][A-Za-z0-9._:-]*$/);",
          "});",
          "",
          "const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
          "if (contentType.includes(\"application/json\")) {",
          "  const body = pm.response.json();",
          "  pm.test(\"JSON response never exposes a stack trace\", function () {",
          "    pm.expect(JSON.stringify(body)).not.to.include(\"\\\"stack\\\"\");",
          "  });",
          "}"
        ]
      }
    }
  ],
