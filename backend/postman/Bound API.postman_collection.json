              {
                "key": "UCP-Capabilities",
                "value": "dev.ucp.shopping.checkout,dev.ucp.common.payment.ap2_mandate",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent_id\": \"intent_travelbot_vy_471\",\n  \"agent_id\": \"agent_travelbot\",\n  \"merchant_id\": \"merchant_vuelaya\",\n  \"offer_id\": \"offer_vy_471_gru_cor\",\n  \"quantity\": 1,\n  \"requested_at\": \"2026-08-29T12:01:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ucp/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["ucp", "v1", "checkout"]
            },
            "description": "Sends only PurchaseIntent. VuelaYa recalculates and signs the authoritative checkout."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout has frozen canonical hash and merchant signature\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  const checkout = pm.response.json();",
                  "  pm.expect(checkout.checkout_hash).to.equal(pm.collectionVariables.get(\"checkoutHash\"));",
                  "  pm.expect(checkout.terms.total).to.deep.equal({ amount: 13700, currency: \"USD\" });",
                  "  pm.expect(checkout.merchant_signature.algorithm).to.equal(\"ES256\");",
                  "  pm.collectionVariables.set(\"checkoutId\", checkout.terms.checkout_id);",
                  "  pm.collectionVariables.set(\"checkoutJson\", JSON.stringify(checkout));",
                  "});"
                ]
              }
            }
          ]
        },
