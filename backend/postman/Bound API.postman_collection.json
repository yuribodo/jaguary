    {
      "name": "VuelaYa UCP subset",
      "item": [
        {
          "name": "VuelaYa UCP profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/.well-known/ucp",
              "host": ["{{baseUrl}}"],
              "path": [".well-known", "ucp"]
            },
            "description": "Returns the pinned normalized VuelaYa profile. Local endpoint relations are advertised in Link."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Profile publishes Checkout + AP2\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.merchant_id).to.equal(\"merchant_vuelaya\");",
                  "  pm.expect(body.protocol).to.deep.equal({ name: \"UCP\", version: \"2026-08-25\" });",
                  "  pm.expect(body.capabilities.map((capability) => capability.name)).to.deep.equal([\"dev.ucp.shopping.checkout\", \"dev.ucp.common.payment.ap2_mandate\"]);",
                  "  pm.expect(body.capabilities[1].extends).to.deep.equal([\"dev.ucp.shopping.checkout\"]);",
                  "  pm.expect(pm.response.headers.get(\"Link\")).to.include(\"/ucp/v1/checkout\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List VuelaYa flights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/merchant/flights",
              "host": ["{{baseUrl}}"],
              "path": ["merchant", "flights"]
            },
            "description": "Lists the deterministic GRU to COR offer for USD 137."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Flight offer is deterministic\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  const offers = pm.response.json();",
                  "  pm.expect(offers).to.have.lengthOf(1);",
                  "  pm.expect(offers[0].offer_id).to.equal(\"offer_vy_471_gru_cor\");",
                  "  pm.expect(offers[0].total).to.deep.equal({ amount: 13700, currency: \"USD\" });",
                  "  pm.expect(offers[0].fulfillment.origin).to.equal(\"GRU\");",
                  "  pm.expect(offers[0].fulfillment.destination).to.equal(\"COR\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create signed checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}-checkout",
                "type": "text"
              },
              {
                "key": "UCP-Capabilities",
                "value": "dev.ucp.shopping.checkout,dev.ucp.common.payment.ap2_mandate",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"intent_id\": \"intent_travelbot_vy_471\",\n  \"agent_id\": \"agent_travelbot\",\n  \"merchant_id\": \"merchant_vuelaya\",\n  \"offer_id\": \"offer_vy_471_gru_cor\",\n  \"quantity\": 1,\n  \"requested_at\": \"2026-08-29T12:01:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/ucp/v1/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["ucp", "v1", "checkout"]
            },
            "description": "Sends only PurchaseIntent. VuelaYa recalculates and signs the authoritative checkout."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout has frozen canonical hash and merchant signature\", function () {",
                  "  pm.response.to.have.status(201);",
                  "  const checkout = pm.response.json();",
                  "  pm.expect(checkout.checkout_hash).to.equal(pm.collectionVariables.get(\"checkoutHash\"));",
                  "  pm.expect(checkout.terms.total).to.deep.equal({ amount: 13700, currency: \"USD\" });",
                  "  pm.expect(checkout.merchant_signature.algorithm).to.equal(\"ES256\");",
                  "  pm.collectionVariables.set(\"checkoutId\", checkout.terms.checkout_id);",
                  "  pm.collectionVariables.set(\"checkoutJson\", JSON.stringify(checkout));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read signed checkout",
          "request": {
            "method": "GET",
            "header": [],
