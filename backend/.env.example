NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://bound_dev:bound_dev_local@localhost:55432/bound_dev

# Principal login. Demo is accepted only with NODE_ENV=development.
AUTH_MODE=demo
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_TRANSACTION_TTL_SECONDS=600
# AUTH_OIDC_ISSUER=https://accounts.google.com
# AUTH_OIDC_CLIENT_ID
# AUTH_OIDC_CLIENT_SECRET
# AUTH_OIDC_CALLBACK_URL=http://localhost:3001/auth/v1/login/google/callback

# Agent attestation. LOCAL is deterministic and performs no external request.
KYA_MODE=LOCAL
KYA_PROVIDER=fake
KYA_REQUEST_TIMEOUT_MS=5000
KYA_ATTESTATION_TTL_SECONDS=31536000
# Required together for EXTERNAL_OPTIONAL or EXTERNAL_REQUIRED:
# KYA_API_BASE_URL=https://verification.didit.me
# KYA_API_KEY
# KYA_WORKFLOW_ID
# KYA_BIOMETRIC_WORKFLOW_ID
# KYA_WEBHOOK_SECRET

# Yuno sandbox adapter (disabled when YUNO_ENABLED is absent; names only)
# YUNO_ENABLED
# YUNO_BASE_URL
# YUNO_ACCOUNT_ID
# YUNO_PUBLIC_API_KEY
# YUNO_PRIVATE_SECRET_KEY
# YUNO_COUNTRY
# YUNO_REQUEST_TIMEOUT_MS

# TravelBot/OpenAI backend runtime (disabled when OPENAI_API_KEY and OPENAI_MODEL are absent; names only)
# OPENAI_API_KEY
# OPENAI_MODEL
# OPENAI_REQUEST_TIMEOUT_MS
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
# OPENAI_VOICE=marin
# TRAVELBOT_AGENT_PRIVATE_JWK
# TRAVELBOT_AGENT_KEY_ID
# TRAVELBOT_AGENT_BUILD_FINGERPRINT
# TRAVELBOT_DEMO_CREDENTIAL_ID
# TRAVELBOT_APPROVAL_ENCRYPTION_KEY

# Live Google Flights results through SerpApi (without a key, search fails closed)
# SERPAPI_API_KEY
# FLIGHT_SEARCH_TIMEOUT_MS=15000
# GOOGLE_FLIGHTS_DEEP_SEARCH=false

# Optional Langfuse telemetry (raw chat text remains disabled; names only)
# LANGFUSE_ENABLED
# LANGFUSE_PUBLIC_KEY
# LANGFUSE_SECRET_KEY
# LANGFUSE_BASE_URL
# RELEASE
