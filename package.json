{
  "name": "bound",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream -r dev",
    "dev:frontend": "pnpm --filter @bound/frontend dev",
    "dev:backend": "pnpm --filter @bound/backend dev",
    "db:up": "docker compose up -d --wait postgres-dev",
    "setup:demo": "pnpm db:up && pnpm --filter @bound/backend db:setup:demo",
    "db:test:up": "docker compose up -d --wait postgres-test",
    "db:test:reset": "docker compose rm -sf postgres-test && docker compose up -d --wait postgres-test",
    "db:down": "docker compose down -v",
    "db:migrate": "pnpm --filter @bound/backend db:migrate",
    "db:test:migrate": "pnpm --filter @bound/backend db:migrate:test",
    "test:integration": "pnpm --filter @bound/backend test:integration",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
